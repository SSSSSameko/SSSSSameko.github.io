{
  "name": "sameko-weibo-lottery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "微博转发抽奖助手，支持候选抓取、筛选、滚动开奖和开奖记录导出。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "web": "npm run build && node server.mjs",
    "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows-start.ps1",
    "probe": "node scripts/probe-mobile-redpacket.mjs",
    "probe:iphone": "node scripts/probe-mobile-redpacket.mjs --device iphone",
    "probe:android": "node scripts/probe-mobile-redpacket.mjs --device android",
    "login": "node scripts/login-web-profile.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.468.0",
    "playwright": "^1.52.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.14"
  }
}
