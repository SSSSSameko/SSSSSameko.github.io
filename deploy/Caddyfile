http://draw.example.com {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://draw.example.com{uri} 308
	}
}

https://draw.example.com {
	encode zstd gzip
	request_body {
		max_size 3MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	# 可选：只允许指定来源访问只读登录态接口（启用前先替换为真实来源 IP）。
	# @cookie path /v1/cookie/current
	# handle @cookie {
	# 	@trusted remote_ip 203.0.113.10
	# 	handle @trusted {
	# 		reverse_proxy 127.0.0.1:4173
	# 	}
	# 	respond 403
	# }
	reverse_proxy 127.0.0.1:4173
}
