{
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

http://draw.example.com {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://draw.example.com{uri} 308
	}
}

https://draw.example.com {
	encode zstd gzip
	request_body {
		max_size 3MB
	}
	# 已知漏洞扫描和环境文件探测在进入应用前直接拒绝，减少无效请求。
	@blocked_probe {
		path /.env* /.git* /wp-admin* /wp-login.php /xmlrpc.php /phpmyadmin* /pma* /vendor/* /server-status /server-info /actuator* /api/actuator* /mcp* /api/mcp* /config.json /home/login.html /sitemap.xml
	}
	handle @blocked_probe {
		respond 404
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	# 可选：只允许指定来源访问只读登录态接口（启用前先替换为真实来源 IP）。
	# @cookie path /v1/cookie/current
	# handle @cookie {
	# 	@trusted remote_ip 203.0.113.10
	# 	handle @trusted {
	# 		reverse_proxy 127.0.0.1:4173
	# 	}
	# 	respond 403
	# }
	reverse_proxy 127.0.0.1:4173
}
